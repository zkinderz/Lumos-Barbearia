# Copie para .env e preencha. Nunca envie o .env para o Git.

# Obrigatorio em producao. Gere um valor novo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Marque como production no deploy: ativa cookie Secure e recusa rodar sem SECRET_KEY
FLASK_ENV=development
FLASK_DEBUG=1

# Onde o SQLite fica. PADRAO: pasta ./data/ (ignorada pelo Git).
# Em deploy aponte para um disco persistente, senao o banco e perdido a cada push.
# DATABASE_PATH=/var/data/barbearia.db

# O admin so existe se voce definir as duas variaveis abaixo.
# NAO existe mais conta admin/admin padrao.
ADMIN_EMAIL=dueno@lumosbarbearia.com.br
ADMIN_PASSWORD=uma-senha-forte-com-8-mais

# Contatos exibidos no site e na politica de privacidade (troque os placeholders)
BIZ_ENDERECO=Rua das Tesouras, 123 - Centro - Sao Paulo/SP
BIZ_WHATSAPP=5511900000000
BIZ_INSTAGRAM=https://instagram.com/lumosbarbearia
BIZ_EMAIL=contato@lumosbarbearia.com.br
BIZ_RESPONSAVEL=Lumos Barbearia LTDA
